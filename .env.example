# ==============================================================================
# INKTHREAD HUB - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# SUPABASE CONFIGURATION
# (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# RAZORPAY CONFIGURATION (Test or Live)
# (Found in Razorpay Dashboard -> Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# EMAIL SYSTEM (Resend or SMTP)
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=InkThread Hub <orders@inkthreadhub.com>

# APPLICATION SETTINGS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_TEST_MODE=true
